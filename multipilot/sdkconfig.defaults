# FPVGate C5MK firmware. See "Build environment" in docs/RADIO_INTERNALS.md.

# The dump trigger (adctrig) and force_rx_gain live in librftest.a, which is
# only linked with the RF certification test option.
CONFIG_ESP_PHY_ENABLE_CERT_TEST=y
# The PLL-tracking timer would race the scanner's direct retunes.
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y

# Keep static data out of the dump bank (0x40820000 up): no IRAM copies of
# the Wi-Fi/PHY hot paths, no AMPDU buffers, no power management.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n
CONFIG_ESP_PHY_IRAM_OPT=n
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_PM_ENABLE=n

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# WARN also silences adctrig's phy_printf (it logs at INFO).
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# The scan task only yields every 50 cycles.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=n

# Native USB carries only framed data; the IDF console stays on UART0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Flash on the Waveshare C5-Zero
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
